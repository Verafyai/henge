{
  "harness_version": 1,
  "name": "lean-prover",
  "version": "1.4.0",
  "runtime": "wasm",
  "entry": "harness.wasm",
  "system_prompt": "system-prompt.md",
  "tools": [],
  "loop": {
    "max_steps": 8,
    "retries": 2,
    "step_timeout_s": 120,
    "total_timeout_s": 900
  },
  "output_schema": "output.schema.json",
  "min_model_class": "code-7b-plus",
  "capabilities": [
    "model.complete"
  ],
  "limits": {
    "memory_mb": 1024,
    "cpu_ms": 600000,
    "wall_s": 900,
    "scratch_mb": 0,
    "processes": 1
  },
  "fixtures": [
    "fixtures/sample-task.json"
  ],
  "licenses": [
    "LICENSE"
  ],
  "sbom": "sbom.cdx.json",
  "x-example": "Fixture bundle. Nodes only run the model and return candidate proof text; Lean checking runs on the coordinator as the swarm's machine-check verifier (decision 2026-11-25). Limits are illustrations."
}
