{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "reproduced",
    "attack"
  ],
  "properties": {
    "reproduced": {
      "type": "boolean"
    },
    "attack": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 20000
    },
    "replay_transcript_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^sha256-[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false
}
