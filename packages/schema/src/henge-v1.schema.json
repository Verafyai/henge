    },
    "roleList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/roleName" } },
    "fieldList": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/dotted" } },
    "idList": {
      "type": "array",
