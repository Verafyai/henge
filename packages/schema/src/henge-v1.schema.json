  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$" },
    "domain": { "type": "string", "pattern": "^(?=.{1,253}$)([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$" },
    "https": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "digest": { "type": "string", "pattern": "^sha256-[a-f0-9]{64}$" },
    "nullableDigest": { "type": ["string", "null"], "pattern": "^sha256-[a-f0-9]{64}$" },
    "relpath": { "type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9._/-]+$", "description": "Bundle-relative path: no leading slash, no .. segment." },
    "pathOrHttps": {
