/** Compiles src/check-wat.ts into src/check-wasm.ts (base64 modules). Run: pnpm --filter @swarm-explorer/sandbox build:checks */
import { writeFileSync } from 'node:fs';
import path from 'node:path';
import { compileChecks } from '../src/check-compile';

const out = path.join(import.meta.dirname, '..', 'src', 'check-wasm.ts');
const mods = await compileChecks();
const body = Object.entries(mods)
  .map(([k, v]) => `  ${k}: '${v}',`)
  .join('\n');
writeFileSync(out, `/** Generated by scripts/build-checks.mts from check-wat.ts. Do not edit. */\nexport const CHECK_WASM: Record<string, string> = {\n${body}\n};\n`);
console.log(`Wrote ${Object.keys(mods).length} check modules.`);
