    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@swarm-explorer/core": "workspace:*",
    "@swarm-explorer/schema": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@swarm-explorer/config": "workspace:*",
    "@types/node": "26.6.7",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
